# Copy to .env for local development and replace values locally.
# Never commit .env or put provider keys in frontend JavaScript.
NUTRIORDER_SECRET_KEY=replace-with-a-long-random-local-secret
NUTRIORDER_DB=nutriorder.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
NUTRIORDER_FRONTEND_ORIGIN=http://localhost:8000
NUTRIORDER_COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:8000/frontend
# Optional SMTP settings for actual password-reset delivery; reset is non-enumerating without these.
MAIL_SERVER=
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
